# microCMS(サーバー側だけで使う。公開しないこと。チャットにも貼らないこと)
# サービスドメイン: https://XXXX.microcms.io の XXXX の部分
MICROCMS_SERVICE_DOMAIN=
# API キー: microCMS の「サービス設定 > APIキー」で発行する
MICROCMS_API_KEY=

# Google アナリティクス(GA4)の計測 ID(G-XXXXXXXXXX)。公開用のビルドだけに設定する。
# Cloudflare Pages の環境変数に、「Production」だけで設定する。ローカルの .env には、通常は入れない(開発中のアクセスが統計に混ざる)。
# 未設定なら、計測もフッターの「Google アナリティクスを使っています」も出ない。
# GA_MEASUREMENT_ID=

# 未設定のあいだは、npm run dev では仮データを表示する。
# npm run generate で仮データのまま確かめたいときだけ、1 にする(公開用のビルドでは付けない)
# MICROCMS_USE_SAMPLE=1
